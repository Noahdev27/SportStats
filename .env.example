# Environnement d'exécution : development | production | test
NODE_ENV=development
PORT=3000

# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://sportstats:sportstats@localhost:5432/sportstats?schema=public"

# Origines autorisées pour CORS (séparées par des virgules, "*" pour toutes)
CORS_ORIGIN=*

# --- IA : Grok (xAI) ---------------------------------------------------------
# Clé API créée sur https://console.x.ai (laisser vide pour désactiver /api/v1/ai)
XAI_API_KEY=
# Modèle utilisé (vérifier la liste des modèles disponibles dans la console xAI)
XAI_MODEL=grok-3-mini
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=60000
# Nombre maximal d'appels IA par minute et par adresse IP (préserve les crédits gratuits)
AI_RATE_LIMIT_PER_MINUTE=10
