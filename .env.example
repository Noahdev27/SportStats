# Environnement d'exécution : development | production | test
NODE_ENV=development
PORT=3000

# Chaîne de connexion PostgreSQL (locale, via docker compose)
DATABASE_URL="postgresql://sportstats:sportstats@localhost:5432/sportstats?schema=public"

# Neon : DATABASE_URL = chaîne « pooled » (hôte en -pooler) utilisée par l'API,
# DIRECT_URL = chaîne directe (sans -pooler), utilisée uniquement par les migrations Prisma.
# Les deux se copient depuis la console Neon (bouton « Connect »).
# DATABASE_URL="postgresql://<role>:<mot_de_passe>@ep-xxx-pooler.<region>.aws.neon.tech/sportstats?sslmode=require"
# DIRECT_URL="postgresql://<role>:<mot_de_passe>@ep-xxx.<region>.aws.neon.tech/sportstats?sslmode=require"

# Origines autorisées pour CORS (séparées par des virgules, "*" pour toutes)
CORS_ORIGIN=*

# --- IA : Groq (ou toute API compatible OpenAI) --------------------------------
# Clé API gratuite créée sur https://console.groq.com/keys (laisser vide pour désactiver /api/v1/ai)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
# Modèle utilisé (liste et limites gratuites : https://console.groq.com/settings/limits)
AI_MODEL=openai/gpt-oss-120b
# Effort de raisonnement des modèles gpt-oss : low | medium | high, ou none pour ne pas l'envoyer
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=60000
# Nombre maximal d'appels IA par minute et par adresse IP (préserve le quota gratuit)
AI_RATE_LIMIT_PER_MINUTE=5
