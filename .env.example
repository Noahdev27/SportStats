# Environnement d'exécution : development | production | test
NODE_ENV=development
PORT=3000

# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://sportstats:sportstats@localhost:5432/sportstats?schema=public"

# Origines autorisées pour CORS (séparées par des virgules, "*" pour toutes)
CORS_ORIGIN=*
